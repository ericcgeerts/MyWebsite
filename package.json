{
  "name": "ericconnelly-website",
  "version": "2.0.0",
  "description": "Modern personal website for Eric Connelly - Cloud Solutions Engineer",
  "scripts": {
    "dev": "npx serve .",
    "lint:css": "npx stylelint 'assets/css/modern.css'",
    "lint:js": "npx eslint 'assets/js/modern.js'",
    "format": "npx prettier --write '**/*.{html,css,js,md}'",
    "lighthouse": "npx lighthouse http://localhost:3000/index-modern.html --view",
    "deploy": "aws s3 sync . s3://your-bucket --exclude 'node_modules/*' --exclude '.git/*' --exclude '*.md'",
    "invalidate": "aws cloudfront create-invalidation --distribution-id YOUR_DIST_ID --paths '/*'"
  },
  "keywords": [
    "portfolio",
    "aws",
    "cloud",
    "serverless"
  ],
  "author": "Eric Connelly",
  "license": "MIT",
  "devDependencies": {},
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
